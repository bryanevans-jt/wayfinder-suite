# Supabase — same project as Wayfinder Pro (apps/staff) / Wayfinder-Production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Production only — shared sign-in across Wayfinder Pro and Rendezvous subdomains
NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=.thejoshuatree.org
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cross-app URLs
NEXT_PUBLIC_STAFF_APP_URL=https://wayfinder-pro.thejoshuatree.org
# Canonical public origin for booking / cancel / reschedule / email / webhook links
APP_BASE_URL=https://rendezvous.thejoshuatree.org
NEXT_PUBLIC_RENDEZVOUS_APP_URL=https://rendezvous.thejoshuatree.org
# Optional alias of APP_BASE_URL (same value if set)
# NEXT_PUBLIC_APP_BASE_URL=https://rendezvous.thejoshuatree.org

# Google Workspace service account (domain-wide delegation) — server only, never NEXT_PUBLIC_
GOOGLE_SERVICE_ACCOUNT_EMAIL=rendezvous-calendar@your-gcp-project.iam.gserviceaccount.com
# Paste the full PEM; escape newlines as \n in Vercel env UI
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Shared secret echoed on Calendar push notifications
GOOGLE_CALENDAR_WEBHOOK_TOKEN=generate-a-long-random-string

# Email (Gmail API via the same service account, impersonating the mailbox)
RENDEZVOUS_FROM_EMAIL=scheduling@thejoshuatree.org
# Master switch — leave false during development so no real mail is sent
RENDEZVOUS_EMAILS_ENABLED=false
# When true, API may pass forceTestEmail for an explicit test send even if emails are off
RENDEZVOUS_ALLOW_TEST_EMAIL=false

# Vercel cron auth
CRON_SECRET=your-random-secret-string

# Optional: same VAPID keys as staff if you want web push from notifyUser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bryan.evans@thejoshuatree.org
